# SO-101 controller boards (CH343, USB 1a86:55d3). One line per board, keyed to its serial number.
# Find a new board's serial with:  udevadm info -a -n /dev/ttyACM0 | grep -m1 'ATTRS{serial}'
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", ATTRS{serial}=="5A46085181", SYMLINK+="so101_follower", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", ATTRS{serial}=="5A46084032", SYMLINK+="so101_follower_2", GROUP="dialout", MODE="0660"


# Add as boards arrive (replace the serials), then re-run system/setup.sh on every machine:
# SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", ATTRS{serial}=="LEADER_SERIAL",     SYMLINK+="so101_leader",     GROUP="dialout", MODE="0660"
